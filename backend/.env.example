# Server Configuration
PORT=5000
NODE_ENV=production

# Database (Required on Vercel / Production)
# Get a free cloud database URI from MongoDB Atlas (https://www.mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/yuvasetu?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_strong_jwt_secret_key_minimum_32_characters

# Client & CORS Configuration
# For unified Vercel deployment: your Vercel deployment domain (e.g. https://your-project.vercel.app)
# For local development: http://localhost:5173
CLIENT_URL=http://localhost:5173
# Additional allowed origins (comma separated or * for open)
# CORS_ORIGIN=https://your-project.vercel.app

# Admin Bootstrap Credentials
# Used ONCE on startup to automatically create the initial Placement Cell admin account.
ADMIN_NAME=Placement Cell Admin
ADMIN_EMAIL=admin@yuvasetu.edu
ADMIN_MOBILE=9876543210
# Must be 8+ characters and contain uppercase, lowercase, digit, and special character
ADMIN_PASSWORD=Admin@YuvaSetu#2026
